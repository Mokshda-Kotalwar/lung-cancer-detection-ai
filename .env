# Environment Variables Template for Lung Cancer Detection Dashboard

# Server port (default: 8501)
PORT=8501

# Streamlit variables
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true

# Database Configuration
# Provide a valid MongoDB connection string (e.g. MongoDB Atlas or local container)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=lung_cancer_db

# Model Parameters (optional overrides)
YOLO_CONF_THRESHOLD=0.45
YOLO_IOU_THRESHOLD=0.5
CLASSIFICATION_MODEL=DenseNet121
